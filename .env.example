# =============================================================================
# SentinelTrade - .env.example
# -----------------------------------------------------------------------------
#   cp .env.example .env
#
# Rules (RNF-SEG-09):
#   - This file is versioned and NEVER holds a real secret.
#   - The values below are DEV-ONLY placeholders so `docker compose up --build`
#     works out of the box. Change every value marked [secret] outside dev.
# =============================================================================

# --- Application ---
APP_PORT=8080

# --- MySQL (container sentinel-db; port 3306 is never published) ---
DB_NAME=sentineltrade
DB_USER=sentinel_app
# [secret]
DB_PASSWORD=dev-only-db-password
# [secret]
DB_ROOT_PASSWORD=dev-only-db-root-password

# --- Authentication / MFA ---
# [secret] HMAC key for JWTs, at least 32 bytes
JWT_SIGNING_KEY=dev-only-jwt-signing-key-at-least-32-bytes-long
# [secret] encrypts TOTP secrets at rest (AES-GCM)
MFA_SECRET_ENCRYPTION_KEY=dev-only-mfa-encryption-key

# --- Simulated exchange ---
# Share (0..1) of submissions whose response is "lost", exercising reconciliation.
EXCHANGE_TIMEOUT_RATE=0.1

# --- Demo data (dev only): creates users trader / auditor / admin ---
SEED_DEMO_DATA=true
# [secret]
DEMO_PASSWORD=Sentinel-2026
# [secret] base32 TOTP seed to add to an authenticator app
DEMO_MFA_SECRET=JBSWY3DPEHPK3PXP
